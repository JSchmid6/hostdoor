#!/bin/bash
# cockpit-dienste-update-action — typed install helper for server-dienste, the
# repository behind the root supervisor through which the agent operates the
# host's Docker services. Pinned for the cockpit-executor service account.
#
# Usage (exactly; no other arguments are accepted):
#   cockpit-dienste-update-action status
#   cockpit-dienste-update-action diff <commit-sha>
#   cockpit-dienste-update-action show <path below the repository>
#   cockpit-dienste-update-action <commit-sha> <diff-sha256>
#     commit-sha: full lowercase 40-hex; diff-sha256: full lowercase 64-hex
#
# Security contract:
#   * Fixed argument form; nothing else is accepted. A bare <commit-sha> (the
#     pre-review form) is refused with 65: every install comes from a job whose
#     diff the running Cockpit reviewed (update-review.ts, guarantees D1-D8).
#   * The helper never runs git or touches the repository in its own sandboxed
#     context (the executor has no network). It starts the repository's runner
#     (<repo>/bin/uebernehmen) in a transient, collected unit and passes its
#     JSON through. The runner is the one of the INSTALLED stand: a change to
#     it is part of the reviewed diff before it ever runs.
#   * Before starting it, the helper checks that the runner and the repository
#     are root-owned and not writable by group or others, so a non-root user
#     cannot swap the code that runs as root.
#   * The runner re-verifies on its own: allowlisted origin, commit merged into
#     origin/main, fast-forward from the installed stand, diff hash equals the
#     reviewed one; it tests the new stand as nobody, then fast-forwards,
#     restarts the supervisor and rolls back when its health check fails.
#   * show <path> is read-only review input for the doorkeeper of the host door
#     (doc/setup/host-run.md, "Code aus geprüften Repos"): it prints one file
#     of the installed stand (at most SHOW_MAX bytes, base64, cut marked) with
#     its sha256, the installed HEAD, whether the file is byte for byte the
#     blob of HEAD and whether the tracked tree is clean; the content only
#     when the file is byte for byte that blob, and then read from the blob
#     itself (an untracked or locally changed file gets its hashes, no
#     content: the form shows what git already holds). Only a regular file
#     below the repository, no symlink on the way, no component that starts
#     with a dot (no .git, no ..). It runs no network and changes nothing
#     (git without optional locks, fsmonitor or untracked cache), so it reads
#     in the helper's own context (git is local here).
#   * Exit codes: 64 usage | 65 target rejected | 66 state | 67 environment |
#     68 verification failed | 69 execution failed (the runner's own codes
#     pass through).
#
# Harness hooks (COCKPIT_DIENSTE_REPO_DIR, _SYSTEMD_RUN, _PYTHON, _SKIP_OWNER_CHECK)
# redirect paths for offline tests. sudo(8) resets the environment
# (env_reset) and the executor broker passes only PATH, so the typed executor
# path always sees the real ones.
set -euo pipefail
PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

readonly REPO_DIR="${COCKPIT_DIENSTE_REPO_DIR:-/opt/server-dienste}"
readonly SYSTEMD_RUN="${COCKPIT_DIENSTE_SYSTEMD_RUN:-/usr/bin/systemd-run}"
readonly PYTHON="${COCKPIT_DIENSTE_PYTHON:-/usr/bin/python3}"
readonly RUNNER="$REPO_DIR/bin/uebernehmen"
readonly GIT="${COCKPIT_DIENSTE_GIT:-/usr/bin/git}"
readonly SHOW_MAX=65536
readonly SHOW_PATH='^[A-Za-z0-9_][A-Za-z0-9_.+-]*(/[A-Za-z0-9_][A-Za-z0-9_.+-]*){0,7}$'

ACTION="none"

json_escape() {
  local value="${1:0:300}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/ }"
  value="${value//$'\r'/ }"
  value="${value//$'\t'/ }"
  printf '%s' "$value"
}

fail() { # fail <exit-code> <message>
  printf '{"ok":false,"action":"%s","error":"%s","code":%s}\n' \
    "$(json_escape "$ACTION")" "$(json_escape "$2")" "$1" >&2
  exit "$1"
}

check_owner() { # the code that runs as root must be root's alone
  local path
  if [ "${COCKPIT_DIENSTE_SKIP_OWNER_CHECK:-}" = "1" ]; then return 0; fi
  for path in "$REPO_DIR" "$REPO_DIR/bin" "$RUNNER" "$REPO_DIR/.git"; do
    [ -e "$path" ] || fail 67 "missing: $path"
    if [ -L "$path" ]; then fail 67 "symlink not allowed: $path"; fi
    if [ "$(stat -c %u "$path")" != "0" ]; then fail 67 "not root-owned: $path"; fi
    if [ $(( 0$(stat -c %a "$path") & 022 )) -ne 0 ]; then fail 67 "writable by group or others: $path"; fi
  done
}

run_runner() { # run_runner <runtime-max-sec> <args...>
  local max="$1"; shift
  check_owner
  exec "$SYSTEMD_RUN" --wait --collect --pipe --quiet \
    --unit="server-dienste-uebernahme-$(date +%s)-$$" \
    --description="server-dienste: $ACTION" \
    -p RuntimeMaxSec="$max" -p Nice=5 \
    "$PYTHON" "$RUNNER" "$@"
}

# git in the show path changes nothing and runs no repository hook: no optional
# index refresh (GIT_OPTIONAL_LOCKS=0), no core.fsmonitor command from
# .git/config, no untracked cache (doc/setup/self-update.md, G4).
show_git() { GIT_OPTIONAL_LOCKS=0 "$GIT" -C "$REPO_DIR" -c core.fsmonitor=false -c core.untrackedCache=false "$@"; }

show_file() { # show_file <relative path>
  local rel="$1" file real size head head_blob file_blob tree_clean=false matches=false truncated=false sha content
  [ "${#rel}" -le 200 ] && [[ "$rel" =~ $SHOW_PATH ]] || fail 65 "path must be relative below the repository, without dot components"
  check_owner
  file="$REPO_DIR/$rel"
  if [ ! -e "$file" ] && [ ! -L "$file" ]; then
    printf '{"ok":true,"action":"dienste.show","path":"%s","exists":false}\n' "$rel"
    exit 0
  fi
  real="$(realpath -e -- "$file" 2>/dev/null)" || fail 65 "path does not resolve: $rel"
  [ "$real" = "$(realpath -e -- "$REPO_DIR")/$rel" ] || fail 65 "symlink on the way: $rel"
  [ -f "$real" ] || fail 65 "not a regular file: $rel"
  size="$(stat -c %s -- "$real")"
  sha="$(sha256sum -- "$real" | cut -d' ' -f1)"
  head="$(show_git rev-parse --verify -q HEAD)" || fail 67 "no HEAD in $REPO_DIR"
  head_blob="$(show_git rev-parse --verify -q "HEAD:$rel" 2>/dev/null || true)"
  file_blob="$(show_git hash-object --no-filters -- "$real")" || fail 67 "git hash-object failed"
  [ -n "$head_blob" ] && [ "$head_blob" = "$file_blob" ] && matches=true
  [ -z "$(show_git status --porcelain=v1 --untracked-files=no --ignore-submodules 2>/dev/null || echo dirty)" ] && tree_clean=true
  [ "$size" -gt "$SHOW_MAX" ] && truncated=true
  # Content only for a file identical to the installed commit, and read from the
  # git blob, not from the working file: the helper shows what git already holds
  # (what dienste.diff shows), never an untracked or locally changed file, and a
  # hardlink or a symlink swapped in after the checks above shows nothing else.
  content=""
  if [ "$matches" = true ]; then
    # head closes the pipe early on a cut file (SIGPIPE under pipefail), so the
    # length of what came out is the check instead of the pipe's status.
    content="$(set +o pipefail; show_git cat-file blob "$head_blob" | head -c "$SHOW_MAX" | base64 -w0)"
    [ "$(printf '%s' "$content" | base64 -d | wc -c)" -eq "$(( size < SHOW_MAX ? size : SHOW_MAX ))" ] || fail 67 "git cat-file failed: $rel"
  fi
  printf '{"ok":true,"action":"dienste.show","path":"%s","exists":true,"head":"%s","headBlob":"%s","fileBlob":"%s","matchesHead":%s,"treeClean":%s,"sha256":"%s","size":%s,"truncated":%s,"contentBase64":"%s"}\n' \
    "$rel" "$head" "$head_blob" "$file_blob" "$matches" "$tree_clean" "$sha" "$size" "$truncated" "$content"
}

if [ "$#" -eq 1 ] && [ "$1" = "status" ]; then
  ACTION="dienste.status"
  run_runner 60 stand
elif [ "$#" -eq 2 ] && [ "$1" = "diff" ]; then
  ACTION="dienste.diff"
  [[ "$2" =~ ^[a-f0-9]{40}$ ]] || fail 65 "commit must be a full lowercase 40-hex sha"
  run_runner 420 diff "$2"
elif [ "$#" -eq 2 ] && [ "$1" = "show" ]; then
  ACTION="dienste.show"
  show_file "$2"
elif [ "$#" -eq 2 ]; then
  ACTION="dienste.update"
  [[ "$1" =~ ^[a-f0-9]{40}$ ]] || fail 65 "commit must be a full lowercase 40-hex sha"
  [[ "$2" =~ ^[a-f0-9]{64}$ ]] || fail 65 "reviewed diff hash must be a full lowercase 64-hex sha256"
  # einspielen zieht Images und startet docker compose: nie am Zeitlimit beenden
  # (cockpit-state-steps.mjs, Vorgabe 11.10.2026) — die Unit hat keine Obergrenze.
  run_runner infinity einspielen "$1" "$2"
elif [ "$#" -eq 1 ] && [[ "$1" =~ ^[a-f0-9]{40}$ ]]; then
  ACTION="dienste.update"
  fail 65 "an install needs the reviewed diff hash; run it as a Cockpit job"
else
  fail 64 "usage: cockpit-dienste-update-action status | diff <sha> | show <path> | <sha> <diff-sha256>"
fi
